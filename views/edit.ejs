<!DOCTYPE html>
<html lang="en">

<head>
     <meta charset="UTF-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>Edit</title>
     <script src="https://cdn.tailwindcss.com"></script>

</head>

<body>
     <div class="bg-gray-100 main min-h-screen p-10">
          <a class="text-blue-500" href="/">Go back to Home</a>

          <div class="mt-3">
               <form action="/edit" method="post" class="space-y-4 mb-6">
                    <input type="text" placeholder="Previous File Name" name="previous" value="<%= filename %>" disabled="true"
                         class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400"
                         required />
                    <input type="text" placeholder="New File Name" name="new"
                         class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400"
                         required />
                    <button type="submit"
                         class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 rounded-md transition">
                         Update Note File
                    </button>
               </form>
          </div>
     </div>

</body>

</html>