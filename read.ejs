<!DOCTYPE html>
<html lang="en">

<head>
     <meta charset="UTF-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>
          <%= title %>
     </title>
     <link rel="stylesheet" href="/stylesheets/style.css" />
     <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-900 min-h-screen p-6">
     <div class="max-w-5xl mx-auto">
          <div class="nav mb-10 text-blue-500">
               <a href="/">Home</a>
          </div>

          <h1 class="text-3xl font-bold text-center text-white mb-8">Users</h1>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
               <% if(users.length > 0) { %>
               <% users.forEach((user) => { %>
                    <!-- User Card -->
                    <div class="bg-white p-4 rounded-lg shadow-md flex flex-col items-center space-y-4">
                         <img src="<%= user.imageUrl %>" alt="User Image"
                              class="w-24 h-24 rounded-full object-cover" />
                         <div class="text-center">
                              <h2 class="text-lg font-semibold text-gray-800"><%= user.name %></h2>
                              <p class="text-sm text-gray-600"><%= user.email %></p>
                         </div>
                         <div class="flex space-x-3">
                              <button
                                   class="bg-blue-500 text-white px-4 py-1 rounded hover:bg-blue-600 transition"><a href="/edit/<%= user._id%>">Edit</a></button>
                              <button
                                   class="bg-red-500 text-white px-4 py-1 rounded hover:bg-red-600 transition"><a href="/delete/<%= user._id%>">Delete</a></button>
                         </div>
                    </div>

               <% }) %>
               <% } else { %>
               <div class="col-span-1 sm:col-span-2 lg:col-span-3 bg-white p-6 rounded-lg shadow-md text-center">
                    <p class="text-gray-600">No users found.</p>
               <% } %>
          </div>
     </div>
</body>


</html>